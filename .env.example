# database (local container, fixed development values)
MINUTES_DATABASE_URL=postgresql://minutes:minutes@127.0.0.1:5433/minutes
MINUTES_TEST_DATABASE_URL=postgresql://minutes:minutes@127.0.0.1:5433/minutes_test
MINUTES_SQL_TOOL_DATABASE_URL=postgresql://minutes_ro:minutes_ro@127.0.0.1:5433/minutes
MINUTES_SQL_TOOL_TEST_DATABASE_URL=postgresql://minutes_ro:minutes_ro@127.0.0.1:5433/minutes_test

# language model endpoint (OpenAI-compatible); leave empty to use the stub
MINUTES_LLM_BASE_URL=
MINUTES_LLM_API_KEY=
MINUTES_LLM_MODE=stub
MINUTES_LLM_DAILY_CAP=500

# local models: stub, gpu, or replay
MINUTES_MODELS_MODE=stub

# corpus: fixture, dev, or full
MINUTES_CORPUS=fixture

MINUTES_DATA_DIR=data
MINUTES_OTEL_ENDPOINT=
MINUTES_QUERY_BUDGET_USD=0.05
MINUTES_LOG_LEVEL=INFO
MINUTES_LOG_FILE=
MINUTES_API_PORT=8000
MINUTES_FAULT=
